# LMU Telemetry Lab — Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to git — it contains secrets.

# --- Deployment mode ---
# "local"  = desktop app, no auth, all endpoints enabled (default)
# "server" = hosted for friends, auth required, dangerous endpoints disabled
APP_MODE=local

# --- Authentication (server mode only) ---
# Comma-separated bearer tokens. Give one to each user.
# Generate tokens with: python -c "import secrets; print(secrets.token_urlsafe(32))"
AUTH_TOKENS=

# --- CORS ---
# Comma-separated allowed origins (frontend URLs)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# --- AI Coach (Claude API) ---
# Get your key at https://console.anthropic.com/
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# Room for the model's thinking + the JSON answer
ANTHROPIC_MAX_TOKENS=16000
# Thinking depth: low | medium | high | xhigh | max (higher = better but pricier)
ANTHROPIC_EFFORT=medium
# Knowledge-base cache lifetime: "1h" (pays off from 2 analyses in the hour) or "5m"
ANTHROPIC_CACHE_TTL=1h

# --- Debug ---
DEBUG=false
